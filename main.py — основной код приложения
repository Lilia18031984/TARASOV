import tkinter as tk
from tkinter import ttk, messagebox
import random
import string
import json
import os
from datetime import datetime

class RandomPasswordGenerator:
    def __init__(self, root):
        self.root = root
        self.root.title("Random Password Generator - Генератор паролей")
        self.root.geometry("900x750")
        self.root.resizable(True, True)

        # Файл для хранения истории
        self.history_file = "passwords.json"
        self.history = self.load_history()

        # Создание интерфейса
        self.create_widgets()
        
        # Отображение истории
        self.display_history()
        
        # Генерация первого пароля
        self.generate_password()

    def load_history(self):
        """Загрузка истории из JSON файла"""
        if os.path.exists(self.history_file):
            try:
                with open(self.history_file, 'r', encoding='utf-8') as f:
                    return json.load(f)
            except:
                return []
        return []

    def save_history(self):
        """Сохранение истории в JSON файл"""
        with open(self.history_file, 'w', encoding='utf-8') as f:
            json.dump(self.history, f, indent=4, ensure_ascii=False)

    def create_widgets(self):
        # Основной фрейм
        main_frame = ttk.Frame(self.root, padding="15")
        main_frame.pack(fill=tk.BOTH, expand=True)

        # ==================== Верхняя панель - Генератор ====================
        generator_frame = ttk.LabelFrame(main_frame, text="Генератор паролей", padding="15")
        generator_frame.pack(fill=tk.X, pady=(0, 15))

        # Ползунок длины пароля
        length_frame = ttk.Frame(generator_frame)
        length_frame.pack(fill=tk.X, pady=(0, 15))
        
        ttk.Label(length_frame, text="Длина пароля:", font=("Arial", 11, "bold")).pack(side=tk.LEFT, padx=(0, 10))
        
        self.length_value = tk.IntVar(value=12)
        self.length_slider = ttk.Scale(length_frame, from_=4, to=32, orient=tk.HORIZONTAL, 
                                        variable=self.length_value, command=self.update_length_label)
        self.length_slider.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=(0, 10))
        
        self.length_label = ttk.Label(length_frame, text="12", font=("Arial", 11))
        self.length_label.pack(side=tk.LEFT)
        
        # Минимальная и максимальная длина
        ttk.Label(generator_frame, text="Диапазон: от 4 до 32 символов", 
                  font=("Arial", 8), foreground="gray").pack(anchor=tk.W, pady=(0, 10))

        # Чекбоксы для выбора символов
        chars_frame = ttk.LabelFrame(generator_frame, text="Типы символов", padding="10")
        chars_frame.pack(fill=tk.X, pady=(0, 15))
        
        self.use_lowercase = tk.BooleanVar(value=True)
        self.use_uppercase = tk.BooleanVar(value=True)
        self.use_digits = tk.BooleanVar(value=True)
        self.use_symbols = tk.BooleanVar(value=True)
        
        ttk.Checkbutton(chars_frame, text="Строчные буквы (a-z)", variable=self.use_lowercase).pack(anchor=tk.W, pady=2)
        ttk.Checkbutton(chars_frame, text="Заглавные буквы (A-Z)", variable=self.use_uppercase).pack(anchor=tk.W, pady=2)
        ttk.Checkbutton(chars_frame, text="Цифры (0-9)", variable=self.use_digits).pack(anchor=tk.W, pady=2)
        ttk.Checkbutton(chars_frame, text="Спецсимволы (!@#$%^&*)", variable=self.use_symbols).pack(anchor=tk.W, pady=2)
        
        # Предупреждение
        self.warning_label = ttk.Label(chars_frame, text="⚠ Выберите хотя бы один тип символов", 
                                        font=("Arial", 8), foreground="red")
        
        # Кнопка генерации
        self.generate_btn = ttk.Button(generator_frame, text="🔐 Сгенерировать пароль", 
                                        command=self.generate_password, width=30)
        self.generate_btn.pack(pady=(0, 15))

        # Отображение сгенерированного пароля
        password_display_frame = ttk.Frame(generator_frame)
        password_display_frame.pack(fill=tk.X)
        
        ttk.Label(password_display_frame, text="Сгенерированный пароль:", font=("Arial", 11, "bold")).pack(anchor=tk.W)
        
        self.password_text = tk.Text(password_display_frame, height=2, wrap=tk.WORD, font=("Courier", 12))
        self.password_text.pack(fill=tk.X, pady=(5, 10))
        
        # Кнопка копирования
        self.copy_btn = ttk.Button(generator_frame, text="📋 Копировать в буфер обмена", 
                                    command=self.copy_to_clipboard, width=30)
        self.copy_btn.pack()

        # Индикатор сложности пароля
        self.strength_label = ttk.Label(generator_frame, text="Сложность: ---", font=("Arial", 10))
        self.strength_label.pack(pady=(10, 0))

        # ==================== Нижняя панель - История ====================
        history_frame = ttk.LabelFrame(main_frame, text="История сгенерированных паролей", padding="10")
        history_frame.pack(fill=tk.BOTH, expand=True)

        # Таблица истории
        columns = ("date", "password", "length", "strength")
        self.history_tree = ttk.Treeview(history_frame, columns=columns, show="headings", height=12)
        
        self.history_tree.heading("date", text="Дата и время")
        self.history_tree.heading("password", text="Пароль")
        self.history_tree.heading("length", text="Длина")
        self.history_tree.heading("strength", text="Сложность")
        
        # Настройка ширины колонок
        self.history_tree.column("date", width=150)
        self.history_tree.column("password", width=350)
        self.history_tree.column("length", width=80)
        self.history_tree.column("strength", width=100)
        
        # Скроллбар
        scrollbar = ttk.Scrollbar(history_frame, orient=tk.VERTICAL, command=self.history_tree.yview)
        self.history_tree.configure(yscrollcommand=scrollbar.set)
        
        self.history_tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
        
        # Кнопки управления историей
        hist_btn_frame = ttk.Frame(history_frame)
        hist_btn_frame.pack(fill=tk.X, pady=(10, 0))
        
        self.clear_history_btn = ttk.Button(hist_btn_frame, text="🗑 Очистить историю", command=self.clear_history)
        self.clear_history_btn.pack(side=tk.LEFT, padx=(0, 5))
        
        self.export_history_btn = ttk.Button(hist_btn_frame, text="💾 Экспорт истории", command=self.export_history)
        self.export_history_btn.pack(side=tk.LEFT)
        
        # Привязка двойного клика для использования пароля
        self.history_tree.bind("<Double-1>", self.use_password_from_history)
        
        # Статусная строка
        self.status_var = tk.StringVar()
        self.status_var.set("Готов к работе")
        status_bar = ttk.Label(self.root, textvariable=self.status_var, relief=tk.SUNKEN, anchor=tk.W)
        status_bar.pack(side=tk.BOTTOM, fill=tk.X)

    def update_length_label(self, event=None):
        """Обновление метки длины пароля"""
        self.length_label.config(text=f"{int(self.length_value.get())}")

    def check_character_types(self):
        """Проверка, выбран ли хотя бы один тип символов"""
        if not (self.use_lowercase.get() or self.use_uppercase.get() or 
                self.use_digits.get() or self.use_symbols.get()):
            self.warning_label.pack(anchor=tk.W, pady=(5, 0))
            return False
        else:
            self.warning_label.pack_forget()
            return True

    def generate_password(self):
        """Генерация случайного пароля"""
        # Проверка выбора символов
        if not self.check_character_types():
            messagebox.showwarning("Предупреждение", "Выберите хотя бы один тип символов!")
            return
        
        # Получение длины пароля
        length = int(self.length_value.get())
        
        # Проверка минимальной/максимальной длины
        if length < 4:
            length = 4
            self.length_value.set(4)
            self.update_length_label()
            messagebox.showinfo("Информация", "Минимальная длина пароля - 4 символа")
        elif length > 32:
            length = 32
            self.length_value.set(32)
            self.update_length_label()
            messagebox.showinfo("Информация", "Максимальная длина пароля - 32 символа")
        
        # Формирование набора символов
        characters = ""
        if self.use_lowercase.get():
            characters += string.ascii_lowercase
        if self.use_uppercase.get():
            characters += string.ascii_uppercase
        if self.use_digits.get():
            characters += string.digits
        if self.use_symbols.get():
            characters += "!@#$%^&*()_+-=[]{}|;:,.<>?"
        
        # Генерация пароля с гарантией наличия выбранных типов символов
        password_chars = []
        
        # Добавляем по одному символу из каждого выбранного типа
        if self.use_lowercase.get():
            password_chars.append(random.choice(string.ascii_lowercase))
        if self.use_uppercase.get():
            password_chars.append(random.choice(string.ascii_uppercase))
        if self.use_digits.get():
            password_chars.append(random.choice(string.digits))
        if self.use_symbols.get():
            password_chars.append(random.choice("!@#$%^&*()_+-=[]{}|;:,.<>?"))
        
        # Заполняем остальные символы случайным образом
        for _ in range(length - len(password_chars)):
            password_chars.append(random.choice(characters))
        
        # Перемешиваем символы для случайного порядка
        random.shuffle(password_chars)
        password = ''.join(password_chars)
        
        # Отображение пароля
        self.password_text.delete(1.0, tk.END)
        self.password_text.insert(1.0, password)
        
        # Оценка сложности
        strength = self.evaluate_strength(password)
        self.strength_label.config(text=f"Сложность: {strength}")
        
        # Сохранение в историю
        history_entry = {
            "date": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "password": password,
            "length": length,
            "strength": strength,
            "settings": {
                "lowercase": self.use_lowercase.get(),
                "uppercase": self.use_uppercase.get(),
                "digits": self.use_digits.get(),
                "symbols": self.use_symbols.get()
            }
        }
        
        self.history.append(history_entry)
        self.save_history()
        self.display_history()
        
        self.status_var.set(f"Сгенерирован пароль длиной {length} символов. Сложность: {strength}")

    def evaluate_strength(self, password):
        """Оценка сложности пароля"""
        score = 0
        length = len(password)
        
        # Длина
        if length >= 12:
            score += 3
        elif length >= 8:
            score += 2
        elif length >= 6:
            score += 1
        
        # Наличие разных типов символов
        if any(c.islower() for c in password):
            score += 1
        if any(c.isupper() for c in password):
            score += 1
        if any(c.isdigit() for c in password):
            score += 1
        if any(not c.isalnum() for c in password):
            score += 2
        
        # Оценка
        if score >= 7:
            return "Очень высокий 🔒"
        elif score >= 5:
            return "Высокий 🔐"
        elif score >= 3:
            return "Средний ⚠️"
        else:
            return "Низкий ❌"

    def copy_to_clipboard(self):
        """Копирование пароля в буфер обмена"""
        password = self.password_text.get(1.0, tk.END).strip()
        if password:
            self.root.clipboard_clear()
            self.root.clipboard_append(password)
            self.status_var.set("Пароль скопирован в буфер обмена!")
            messagebox.showinfo("Успех", "Пароль скопирован в буфер обмена!")
        else:
            messagebox.showwarning("Предупреждение", "Нет пароля для копирования!")

    def display_history(self):
        """Отображение истории в таблице"""
        # Очистка таблицы
        for item in self.history_tree.get_children():
            self.history_tree.delete(item)
        
        # Добавление записей (от новых к старым)
        for entry in reversed(self.history):
            # Маскируем пароль для отображения (показываем только первые 4 символа и звездочки)
            password = entry["password"]
            if len(password) > 6:
                masked_password = password[:4] + "*" * (len(password) - 4)
            else:
                masked_password = password[:2] + "*" * (len(password) - 2)
            
            self.history_tree.insert("", tk.END, values=(
                entry["date"],
                masked_password,
                entry["length"],
                entry["strength"]
            ))
        
        # Обновление статуса
        if self.history:
            self.status_var.set(f"Всего паролей в истории: {len(self.history)}")
        else:
            self.status_var.set("История пуста")

    def use_password_from_history(self, event):
        """Использование пароля из истории"""
        selected = self.history_tree.selection()
        if not selected:
            return
        
        item = self.history_tree.item(selected[0])
        values = item['values']
        
        # Поиск полного пароля в истории
        for entry in self.history:
            if entry["date"] == values[0]:
                # Показываем диалог для подтверждения
                if messagebox.askyesno("Подтверждение", 
                                       f"Использовать пароль из истории?\n\n"
                                       f"Дата: {entry['date']}\n"
                                       f"Длина: {entry['length']}\n"
                                       f"Сложность: {entry['strength']}\n\n"
                                       f"Пароль будет скопирован в буфер обмена для вставки."):
                    self.password_text.delete(1.0, tk.END)
                    self.password_text.insert(1.0, entry["password"])
                    self.strength_label.config(text=f"Сложность: {entry['strength']}")
                    self.copy_to_clipboard()
                break

    def clear_history(self):
        """Очистка истории"""
        if not self.history:
            messagebox.showinfo("Информация", "История уже пуста")
            return
        
        if messagebox.askyesno("Подтверждение", 
                               "Вы уверены, что хотите очистить всю историю?\n"
                               "Это действие нельзя отменить!"):
            self.history = []
            self.save_history()
            self.display_history()
            self.status_var.set("История очищена")
            messagebox.showinfo("Успех", "История успешно очищена!")

    def export_history(self):
        """Экспорт истории в JSON файл"""
        if not self.history:
            messagebox.showwarning("Предупреждение", "Нет данных для экспорта")
            return
        
        from tkinter import filedialog
        
        filename = filedialog.asksaveasfilename(
            defaultextension=".json",
            filetypes=[("JSON files", "*.json"), ("All files", "*.*")],
            initialfile=f"passwords_history_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        )
        
        if filename:
            try:
                with open(filename, 'w', encoding='utf-8') as f:
                    json.dump(self.history, f, indent=4, ensure_ascii=False)
                messagebox.showinfo("Успех", f"История экспортирована в файл:\n{filename}")
                self.status_var.set("История экспортирована")
            except Exception as e:
                messagebox.showerror("Ошибка", f"Не удалось экспортировать историю\n{str(e)}")

def main():
    root = tk.Tk()
    app = RandomPasswordGenerator(root)
    root.mainloop()

if __name__ == "__main__":
    main()
