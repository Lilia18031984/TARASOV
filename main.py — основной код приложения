import tkinter as tk
from tkinter import ttk, messagebox
import json
import os
import random
from datetime import datetime

class RandomTaskGenerator:
    def __init__(self, root):
        self.root = root
        self.root.title("Random Task Generator - Генератор случайных задач")
        self.root.geometry("950x750")
        self.root.resizable(True, True)

        # Файлы для хранения данных
        self.tasks_file = "tasks.json"
        self.history_file = "history.json"
        
        # Загрузка данных
        self.tasks = self.load_tasks()
        self.history = self.load_history()
        
        # Текущая задача
        self.current_task = None
        
        # Получение уникальных типов задач
        self.update_task_types()
        
        # Создание интерфейса
        self.create_widgets()
        
        # Отображение истории
        self.display_history()
        
        # Генерация первой случайной задачи
        self.generate_random_task()

    def load_tasks(self):
        """Загрузка задач из JSON файла"""
        default_tasks = [
            {"text": "Прочитать 20 страниц книги", "type": "Учёба"},
            {"text": "Сделать зарядку 15 минут", "type": "Спорт"},
            {"text": "Помыть посуду", "type": "Дом"},
            {"text": "Выучить 10 новых слов на английском", "type": "Учёба"},
            {"text": "Пробежать 2 км", "type": "Спорт"},
            {"text": "Написать пост в блог", "type": "работа"},
            {"text": "Помедитировать 10 минут", "type": "Саморазвитие"},
            {"text": "Сделать отчёт по проекту", "type": "работа"},
            {"text": "Позвонить родителям", "type": "Личное"},
            {"text": "Убраться на рабочем столе", "type": "Дом"},
            {"text": "Пройти урок на онлайн-курсе", "type": "Учёба"},
            {"text": "Сделать план на неделю", "type": "работа"},
            {"text": "Почитать новости", "type": "Саморазвитие"},
            {"text": "Записаться к врачу", "type": "Личное"},
            {"text": "Попробовать новый рецепт", "type": "Дом"},
            {"text": "Сделать упражнения для спины", "type": "Спорт"},
            {"text": "Написать код 30 минут", "type": "работа"},
            {"text": "Посмотреть обучающее видео", "type": "Учёба"},
            {"text": "Погулять на свежем воздухе", "type": "Спорт"},
            {"text": "Поблагодарить коллегу", "type": "Личное"}
        ]
        
        if os.path.exists(self.tasks_file):
            try:
                with open(self.tasks_file, 'r', encoding='utf-8') as f:
                    tasks = json.load(f)
                    if tasks:  # Если файл не пустой
                        return tasks
            except:
                pass
        
        # Если файла нет или он пустой, создаём с задачами по умолчанию
        self.save_tasks(default_tasks)
        return default_tasks

    def save_tasks(self, tasks=None):
        """Сохранение задач в JSON файл"""
        if tasks is None:
            tasks = self.tasks
        with open(self.tasks_file, 'w', encoding='utf-8') as f:
            json.dump(tasks, f, indent=4, ensure_ascii=False)

    def load_history(self):
        """Загрузка истории из JSON файла"""
        if os.path.exists(self.history_file):
            try:
                with open(self.history_file, 'r', encoding='utf-8') as f:
                    return json.load(f)
            except:
                return []
        return []

    def save_history(self):
        """Сохранение истории в JSON файл"""
        with open(self.history_file, 'w', encoding='utf-8') as f:
            json.dump(self.history, f, indent=4, ensure_ascii=False)

    def update_task_types(self):
        """Обновление списка типов задач"""
        types = sorted(set(task["type"] for task in self.tasks))
        self.task_types = ["Все"] + types

    def create_widgets(self):
        # Основной фрейм
        main_frame = ttk.Frame(self.root, padding="15")
        main_frame.pack(fill=tk.BOTH, expand=True)

        # ==================== Верхняя панель ====================
        top_frame = ttk.Frame(main_frame)
        top_frame.pack(fill=tk.X, pady=(0, 15))

        self.generate_btn = ttk.Button(top_frame, text="🎲 Сгенерировать случайную задачу", 
                                        command=self.generate_random_task, width=30)
        self.generate_btn.pack(side=tk.LEFT, padx=(0, 10))

        self.add_task_btn = ttk.Button(top_frame, text="➕ Добавить новую задачу", 
                                        command=self.open_add_task_window)
        self.add_task_btn.pack(side=tk.LEFT)

        # ==================== Панель с текущей задачей ====================
        task_frame = ttk.LabelFrame(main_frame, text="Текущая задача", padding="15")
        task_frame.pack(fill=tk.X, pady=(0, 15))

        self.task_text_label = tk.Text(task_frame, height=4, wrap=tk.WORD, 
                                        font=("Arial", 12, "bold"), relief=tk.FLAT)
        self.task_text_label.pack(fill=tk.X, pady=(0, 10))
        self.task_text_label.config(state=tk.DISABLED)

        self.task_info_label = ttk.Label(task_frame, text="", font=("Arial", 10))
        self.task_info_label.pack()

        # Кнопка выполнения задачи
        self.complete_btn = ttk.Button(task_frame, text="✅ Выполнено!", 
                                        command=self.mark_task_complete, width=20)
        self.complete_btn.pack(pady=(10, 0))

        # ==================== Панель фильтрации ====================
        filter_frame = ttk.LabelFrame(main_frame, text="Фильтр истории", padding="10")
        filter_frame.pack(fill=tk.X, pady=(0, 15))

        filter_inner = ttk.Frame(filter_frame)
        filter_inner.pack()

        ttk.Label(filter_inner, text="Фильтр по типу задачи:").pack(side=tk.LEFT, padx=(0, 10))
        self.type_filter = ttk.Combobox(filter_inner, values=self.task_types, width=20, state="readonly")
        self.type_filter.set("Все")
        self.type_filter.pack(side=tk.LEFT, padx=(0, 10))
        self.type_filter.bind("<<ComboboxSelected>>", lambda e: self.filter_history())

        self.reset_filter_btn = ttk.Button(filter_inner, text="Сбросить фильтр", command=self.reset_filter)
        self.reset_filter_btn.pack(side=tk.LEFT)

        # ==================== История ====================
        history_frame = ttk.LabelFrame(main_frame, text="История задач", padding="10")
        history_frame.pack(fill=tk.BOTH, expand=True)

        # Таблица истории
        columns = ("date", "task", "type", "status")
        self.history_tree = ttk.Treeview(history_frame, columns=columns, show="headings", height=12)
        
        self.history_tree.heading("date", text="Дата и время")
        self.history_tree.heading("task", text="Задача")
        self.history_tree.heading("type", text="Тип")
        self.history_tree.heading("status", text="Статус")
        
        # Настройка ширины колонок
        self.history_tree.column("date", width=150)
        self.history_tree.column("task", width=400)
        self.history_tree.column("type", width=120)
        self.history_tree.column("status", width=100)
        
        # Скроллбар
        scrollbar = ttk.Scrollbar(history_frame, orient=tk.VERTICAL, command=self.history_tree.yview)
        self.history_tree.configure(yscrollcommand=scrollbar.set)
        
        self.history_tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
        
        # Кнопки управления
        hist_btn_frame = ttk.Frame(history_frame)
        hist_btn_frame.pack(fill=tk.X, pady=(10, 0))
        
        self.clear_history_btn = ttk.Button(hist_btn_frame, text="🗑 Очистить историю", command=self.clear_history)
        self.clear_history_btn.pack(side=tk.LEFT, padx=(0, 5))
        
        self.export_history_btn = ttk.Button(hist_btn_frame, text="💾 Экспорт истории", command=self.export_history)
        self.export_history_btn.pack(side=tk.LEFT)
        
        self.manage_tasks_btn = ttk.Button(hist_btn_frame, text="📝 Управление задачами", command=self.open_manage_tasks_window)
        self.manage_tasks_btn.pack(side=tk.LEFT, padx=(5, 0))
        
        # Статусная строка
        self.status_var = tk.StringVar()
        self.status_var.set(f"Готов к работе. Всего задач в библиотеке: {len(self.tasks)}")
        status_bar = ttk.Label(self.root, textvariable=self.status_var, relief=tk.SUNKEN, anchor=tk.W)
        status_bar.pack(side=tk.BOTTOM, fill=tk.X)

    def generate_random_task(self):
        """Генерация случайной задачи"""
        if not self.tasks:
            messagebox.showwarning("Предупреждение", "Нет доступных задач! Добавьте хотя бы одну задачу.")
            return
        
        # Выбор случайной задачи
        self.current_task = random.choice(self.tasks)
        
        # Отображение задачи
        self.task_text_label.config(state=tk.NORMAL)
        self.task_text_label.delete(1.0, tk.END)
        self.task_text_label.insert(1.0, f"📌 {self.current_task['text']}")
        self.task_text_label.config(state=tk.DISABLED)
        
        self.task_info_label.config(text=f"Тип: {self.current_task['type']}")
        
        self.status_var.set(f"Сгенерирована задача: {self.current_task['text']}")

    def mark_task_complete(self):
        """Отметка текущей задачи как выполненной и сохранение в историю"""
        if not self.current_task:
            messagebox.showwarning("Предупреждение", "Нет активной задачи! Сначала сгенерируйте задачу.")
            return
        
        # Сохранение в историю
        history_entry = {
            "date": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "task": self.current_task['text'],
            "type": self.current_task['type'],
            "status": "Выполнено ✅"
        }
        
        self.history.append(history_entry)
        self.save_history()
        self.filter_history()  # Обновляем отображение с учётом фильтра
        
        self.status_var.set(f"Задача '{self.current_task['text']}' отмечена как выполненная!")
        messagebox.showinfo("Поздравляем!", f"Задача выполнена!\n\n{self.current_task['text']}")
        
        # Генерируем новую задачу
        self.generate_random_task()

    def filter_history(self):
        """Фильтрация истории по типу задачи"""
        selected_type = self.type_filter.get()
        
        # Очистка таблицы
        for item in self.history_tree.get_children():
            self.history_tree.delete(item)
        
        # Фильтрация
        filtered_history = self.history.copy()
        
        if selected_type != "Все":
            filtered_history = [h for h in filtered_history if h["type"] == selected_type]
        
        # Отображение отфильтрованной истории (от новых к старым)
        for entry in reversed(filtered_history):
            self.history_tree.insert("", tk.END, values=(
                entry["date"],
                entry["task"],
                entry["type"],
                entry["status"]
            ))
        
        # Обновление статуса
        count = len(filtered_history)
        if selected_type != "Все":
            self.status_var.set(f"Найдено {count} задач типа '{selected_type}'")
        else:
            self.status_var.set(f"Всего задач в истории: {count}")

    def reset_filter(self):
        """Сброс фильтра"""
        self.type_filter.set("Все")
        self.filter_history()
        self.status_var.set("Фильтр сброшен")

    def display_history(self):
        """Отображение всей истории"""
        self.filter_history()

    def clear_history(self):
        """Очистка истории"""
        if not self.history:
            messagebox.showinfo("Информация", "История уже пуста")
            return
        
        if messagebox.askyesno("Подтверждение", "Вы уверены, что хотите очистить всю историю?"):
            self.history = []
            self.save_history()
            self.display_history()
            self.status_var.set("История очищена")

    def export_history(self):
        """Экспорт истории в JSON файл"""
        if not self.history:
            messagebox.showwarning("Предупреждение", "Нет данных для экспорта")
            return
        
        from tkinter import filedialog
        
        filename = filedialog.asksaveasfilename(
            defaultextension=".json",
            filetypes=[("JSON files", "*.json"), ("All files", "*.*")],
            initialfile=f"tasks_history_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        )
        
        if filename:
            try:
                with open(filename, 'w', encoding='utf-8') as f:
                    json.dump(self.history, f, indent=4, ensure_ascii=False)
                messagebox.showinfo("Успех", f"История экспортирована в файл:\n{filename}")
                self.status_var.set("История экспортирована")
            except Exception as e:
                messagebox.showerror("Ошибка", f"Не удалось экспортировать историю\n{str(e)}")

    def open_add_task_window(self):
        """Открытие окна для добавления новой задачи"""
        add_window = tk.Toplevel(self.root)
        add_window.title("Добавить новую задачу")
        add_window.geometry("450x350")
        add_window.resizable(False, False)
        add_window.transient(self.root)
        add_window.grab_set()
        
        ttk.Label(add_window, text="Текст задачи:", font=("Arial", 11, "bold")).pack(pady=(15, 5))
        task_text = tk.Text(add_window, height=5, width=50, wrap=tk.WORD)
        task_text.pack(pady=(0, 15))
        
        ttk.Label(add_window, text="Тип задачи:", font=("Arial", 11, "bold")).pack(pady=(5, 5))
        
        # Предустановленные типы
        type_frame = ttk.Frame(add_window)
        type_frame.pack(pady=(0, 10))
        
        task_type = tk.StringVar()
        types = ["Учёба", "Спорт", "работа", "Дом", "Личное", "Саморазвитие", "Другое"]
        
        for i, t in enumerate(types):
            ttk.Radiobutton(type_frame, text=t, variable=task_type, value=t).pack(side=tk.LEFT, padx=5)
        
        # Или свой тип
        ttk.Label(add_window, text="Или введите свой тип:", font=("Arial", 10)).pack(pady=(5, 5))
        custom_type = ttk.Entry(add_window, width=30)
        custom_type.pack(pady=(0, 15))
        
        def save_task():
            text = task_text.get("1.0", tk.END).strip()
            
            # Валидация
            if not text:
                messagebox.showerror("Ошибка", "Текст задачи не может быть пустым!")
                return
            
            # Определение типа
            if custom_type.get().strip():
                task_type_val = custom_type.get().strip()
            elif task_type.get():
                task_type_val = task_type.get()
            else:
                messagebox.showerror("Ошибка", "Выберите или введите тип задачи!")
                return
            
            # Добавление задачи
            new_task = {
                "text": text,
                "type": task_type_val
            }
            
            self.tasks.append(new_task)
            self.save_tasks()
            self.update_task_types()
            
            # Обновление выпадающего списка
            self.type_filter['values'] = self.task_types
            
            self.status_var.set(f"Добавлена новая задача: {text}")
            messagebox.showinfo("Успех", "Задача успешно добавлена!")
            add_window.destroy()
        
        ttk.Button(add_window, text="Сохранить", command=save_task).pack(pady=(10, 5))
        ttk.Button(add_window, text="Отмена", command=add_window.destroy).pack()

    def open_manage_tasks_window(self):
        """Открытие окна управления задачами"""
        manage_window = tk.Toplevel(self.root)
        manage_window.title("Управление задачами")
        manage_window.geometry("600x500")
        manage_window.transient(self.root)
        
        # Список задач
        ttk.Label(manage_window, text="Список всех задач:", font=("Arial", 11, "bold")).pack(pady=(10, 5))
        
        frame = ttk.Frame(manage_window)
        frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=5)
        
        # Создание списка
        task_listbox = tk.Listbox(frame, height=15, font=("Arial", 10))
        scrollbar = ttk.Scrollbar(frame, orient=tk.VERTICAL, command=task_listbox.yview)
        task_listbox.configure(yscrollcommand=scrollbar.set)
        
        task_listbox.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
        
        # Заполнение списка
        for i, task in enumerate(self.tasks, 1):
            task_listbox.insert(tk.END, f"{i}. {task['text']} [{task['type']}]")
        
        # Кнопки управления
        btn_frame = ttk.Frame(manage_window)
        btn_frame.pack(fill=tk.X, padx=10, pady=10)
        
        def delete_task():
            selection = task_listbox.curselection()
            if not selection:
                messagebox.showwarning("Предупреждение", "Выберите задачу для удаления!")
                return
            
            if messagebox.askyesno("Подтверждение", "Удалить выбранную задачу?"):
                index = selection[0]
                deleted_task = self.tasks.pop(index)
                self.save_tasks()
                self.update_task_types()
                self.type_filter['values'] = self.task_types
                task_listbox.delete(index)
                self.status_var.set(f"Задача '{deleted_task['text']}' удалена")
                messagebox.showinfo("Успех", "Задача удалена!")
        
        ttk.Button(btn_frame, text="Удалить выбранную задачу", command=delete_task).pack(side=tk.LEFT, padx=5)
        ttk.Button(btn_frame, text="Закрыть", command=manage_window.destroy).pack(side=tk.LEFT, padx=5)

def main():
    root = tk.Tk()
    app = RandomTaskGenerator(root)
    root.mainloop()

if __name__ == "__main__":
    main()
